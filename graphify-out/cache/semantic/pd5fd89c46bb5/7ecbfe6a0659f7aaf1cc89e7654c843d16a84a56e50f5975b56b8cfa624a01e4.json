{"nodes": [{"id": "tests_diagnostics_jko_testing_readme_algorithm_1", "label": "Algorithm 1 (OU/FP/Cons GRN inference with known mu_k)", "file_type": "concept", "source_file": "tests/diagnostics/jko-testing/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_diagnostics_jko_testing_readme_six_loss_combinations", "label": "Six loss combinations (OU, FP, OU+FP, OU+Cons, FP+Cons, OU+FP+Cons)", "file_type": "rationale", "source_file": "tests/diagnostics/jko-testing/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 6 evaluated rather than one picked 'best', since a single past sweep ranking would be noise."}, {"id": "tests_diagnostics_jko_testing_readme_doc", "label": "JKOnet* comparison", "file_type": "document", "source_file": "tests/diagnostics/jko-testing/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_diagnostics_jko_testing_readme_jkonet_star", "label": "JKOnet* (Terpin et al., NeurIPS 2024)", "file_type": "paper", "source_file": "tests/diagnostics/jko-testing/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_diagnostics_jko_testing_readme_known_intervention_means", "label": "Known intervention means {mu_k}", "file_type": "concept", "source_file": "tests/diagnostics/jko-testing/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JKOnet* has no slot for mu_k, so the comparison measures how much knowing mu_k helps; constant-mu control separates that from fit quality."}, {"id": "tests_diagnostics_jko_testing_readme_sliced_w2_shared_metric", "label": "Shared one-step-ahead sliced-W2 metric (_sliced_w2)", "file_type": "concept", "source_file": "tests/diagnostics/jko-testing/REA